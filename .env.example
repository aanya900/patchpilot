# GitHub App or PAT with `repo` + `workflow` scopes
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret configured on the GitHub webhook, used to verify request signatures
GITHUB_WEBHOOK_SECRET=change_me

# GCP project hosting Cloud Run / Pub/Sub / Firestore
GCP_PROJECT=patchpilot-hackathon

# Pub/Sub topic that decouples webhook receipt from pipeline processing
PUBSUB_TOPIC=patchpilot-failed-runs

# Picked up automatically by google-genai when running on Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=patchpilot-hackathon
GOOGLE_CLOUD_LOCATION=us-central1
